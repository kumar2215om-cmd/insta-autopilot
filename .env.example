# Long-lived Instagram user access token (Instagram API with Instagram Login)
IG_ACCESS_TOKEN=
# App secret from Meta developer dashboard (used to verify webhooks really come from Instagram)
IG_APP_SECRET=
# Any random string; paste the same value in the Meta webhook settings
IG_VERIFY_TOKEN=pick-a-random-string
# Password for the dashboard (username can be anything)
DASHBOARD_PASSWORD=
PORT=8000

# ---- LinkedIn (optional, dashboard at /linkedin) ----
# From your app at https://www.linkedin.com/developers/apps → Auth tab
LI_CLIENT_ID=
LI_CLIENT_SECRET=
# Set to 1 once LinkedIn approves the Community Management API (company page posts + comment automation)
LI_PAGES=0
# For the AI caption writer on /linkedin (https://platform.claude.com → API keys)
ANTHROPIC_API_KEY=
