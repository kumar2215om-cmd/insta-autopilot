# Long-lived Instagram user access token (Instagram API with Instagram Login)
IG_ACCESS_TOKEN=
# App secret from Meta developer dashboard (used to verify webhooks really come from Instagram)
IG_APP_SECRET=
# Any random string; paste the same value in the Meta webhook settings
IG_VERIFY_TOKEN=pick-a-random-string
# Password for the dashboard (username can be anything)
DASHBOARD_PASSWORD=
PORT=8000
